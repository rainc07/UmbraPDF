<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light parent => WebView reports prefers-color-scheme: light; values-night switches to the dark parent. -->
    <style name="Theme.UmbraPDF" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/umbra_bg</item>
        <!-- Android 12+ system splash: plain dark background, no icon, so it blends into the app's own animated splash. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/umbra_splash</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_blank</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
